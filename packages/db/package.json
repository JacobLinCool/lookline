{
  "name": "@lookline/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./node": "./src/node.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx scripts/migrate.ts",
    "reset": "tsx scripts/reset.ts",
    "dump": "tsx scripts/dump.ts",
    "d1:local": "tsx scripts/d1-local.ts",
    "studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
