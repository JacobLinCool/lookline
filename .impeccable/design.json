  "narrative": {
    "northStar": "The Rack",
    "overview": "Lookline is a well-lit store: a white wall, one steel rail, paper tags. The garment is the only colour on the page; the interface is the rail and the tags. The largest element on every screen is a piece of clothing or a Look, the one ink button is the next step in the chain, and text is a caption, never a paragraph.",
    "keyCharacteristics": [
      "Warm-neutral white wall with white paper tags and a recessed panel tone",
      "Ink for every primary action; tag red for the one thing that needs attention",
      "One-pixel rail lines separate groups; borders are for tags and inputs",
      "Bricolage Grotesque signage, Inter operation",
      "Image-first tiles that lift off the rail on hover — the only shadow",
      "Rails for curated sets, grids for catalogs",
      "Engine internals behind the Engine view switch, never on consumer pages"
    ],
    "rules": [
      {
        "name": "The One Colour Rule",
        "body": "Product artwork and Look images supply the page's colour; the interface stays neutral so they can.",
        "section": "colors"
      },
      {
        "name": "The Tag Red Rule",
        "body": "Red marks a single consequential thing per screen. If two things are red, one of them is not.",
        "section": "colors"
      },
      {
        "name": "The Caption Rule",
        "body": "Text under an image is a caption: name, price, one reason. Sentence case, no tracked uppercase, no kickers above headings.",
        "section": "typography"
      },
      {
        "name": "The Signage Rule",
        "body": "Bricolage Grotesque names pages and Looks; Inter operates. Never the reverse.",
        "section": "typography"
      },
      {
        "name": "The First Viewport Rule",
        "body": "On every page the largest thing above the fold is an image; on Find it is the input over a rail of real Looks. Controls never push content below the fold on a 390px screen.",
        "section": "layout"
      },
      {
        "name": "The Rail-or-Grid Rule",
        "body": "Curated sets hang on rails; catalogs stand in grids. Never a stack of same-size cards.",
        "section": "layout"
      },
      {
        "name": "The One Reason Rule",
        "body": "A recommendation carries one plain line from its strongest factors; scores, weights, confidence and breakdowns exist only in Engine view.",
        "section": "components"
      },
      {
        "name": "The Honest State Rule",
        "body": "Loading, unavailable, empty, error, rendering and sample states are visible and distinct, expressed as form rather than prose.",
        "section": "components"
      }
    ],
    "dos": [
      "Do open every page on an image and end it on the one ink button.",
      "Do write like a good clerk: name the outcome, keep the rest to a line.",
      "Do put engine internals behind Engine view and in the Engine lab.",
      "Do hang curated sets on rails and let them bleed to the phone's edge.",
      "Do label sample states with a small \"Sample\" tag."
    ],
    "donts": [
      "Don't put a kicker or eyebrow above a heading, or a slogan in a title.",
      "Don't narrate the system or explain what a button does.",
      "Don't show scores, percentages, confidence or field names to a shopper.",
      "Don't nest cards, border layout groups, or list aesthetic chips under a product.",
      "Don't use red for anything that is not the one thing to notice."
    ]
  }
}
