{
  "name": "@lookline/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vinext dev --port 3000",
    "build": "vinext build",
    "start": "vinext start --port 3000",
    "deploy": "vinext-cloudflare deploy",
    "d1:migrate:local": "wrangler d1 migrations apply lookline --local",
    "d1:migrate:remote": "wrangler d1 migrations apply lookline --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@google/genai": "2.23.0",
    "@lookline/catalog": "workspace:*",
    "@lookline/db": "workspace:*",
    "@lookline/engine": "workspace:*",
    "lucide-react": "1.47.0",
    "nanoid": "6.0.1",
    "openai": "7.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "recharts": "3.10.1",
    "vinext": "1.0.0-beta.10",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.56.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vinext/cloudflare": "1.0.0-beta.8",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wrangler": "4.135.0"
  }
}
