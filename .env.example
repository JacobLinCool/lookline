# ---------------------------------------------------------------------------
# Local scripts (seed / analytics / evaluate / tests) read this file via loadEnv().
# The web app runs inside the Cloudflare Workers runtime (vinext dev = workerd + local D1/R2)
# and reads its secrets from apps/web/.dev.vars locally and from `wrangler secret` in
# production — see apps/web/.dev.vars.example.
# ---------------------------------------------------------------------------

# Local SQLite database the seed scripts write (repo-relative). Copy it into the dev D1 with
# `pnpm d1:local`, into production with `pnpm d1:remote`.
LOOKLINE_SQLITE=data/lookline.sqlite

# Session cookie signing secret (any long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# Optional LLM providers. Without keys every feature falls back to deterministic offline logic.
GEMINI_API_KEY=AIza...
OPENAI_API_KEY=sk-...
TYPESAFE_API_KEY=apikey_...
# Closed-option decisions for live Shop filters (separate from generative providers)
TYPESAFE_MODEL=jev-1.13.0
# Voice uses GEMINI_API_KEY to issue constrained gemini-3.5-transcribe-live session tokens.

# Provider selection: openai | gemini | offline (default: first configured key, openai first)
LLM_TEXT_PROVIDER=
LLM_IMAGE_PROVIDER=

# Optional model overrides (API parameters checked against official docs 2026-09-18)
# Both text adapters explicitly use medium reasoning / thinking effort.
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# OpenAI image effort uses quality: low | medium | high | xhigh | max | auto (default high)
LLM_IMAGE_QUALITY=high

# Catalog generation (pnpm seed:catalog). 100k products ≈ 350 MB of D1 storage (Workers Paid);
# use 20000 on the free plan (500 MB limit).
CATALOG_SEED=20260918
CATALOG_SIZE=100000

# Social simulation (pnpm seed:social)
SIM_SEED=20260918
SIM_USERS=1200
# Fixed "now" for a reproducible 60-day history (ISO timestamp); defaults to the current time
SIM_NOW=2026-09-18T00:15:00Z

# Cloudflare API credentials. `pnpm dev:remote` reads them from here through
# apps/web/vite.config.ts to authenticate the remote D1 and R2 bindings; `pnpm d1:migrate:remote`,
# `pnpm d1:remote` and `pnpm deploy` pick them up as wrangler's own environment.
CLOUDFLARE_API_TOKEN=cfut_...
CLOUDFLARE_ACCOUNT_ID=b1c3d1b89f9131a84a0f1f6a973232f1
